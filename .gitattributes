# Preserve downloadable documents and media byte-for-byte across operating systems.
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary
*.pptx binary
*.potx binary
*.png binary
*.jpg binary
*.webp binary
*.avif binary
*.woff2 binary
*.mp4 binary
*.ts binary
# Published checksums cover text files too, including CRLF in vCard files.
public/brand-assets/** -text
